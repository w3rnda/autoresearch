# LeadFlow CRM + GTM Engine — Environment Variables
# Copy to .env and fill in values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://leadflow:leadflow123@localhost:5432/leadflow"

# ─── Redis (required for GTM Engine workers + email queue) ───────────────────
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=                          # Optional: for Upstash/managed Redis

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# ─── GTM Engine ──────────────────────────────────────────────────────────────
# Set to "true" to start sourcing/enrichment workers on boot
ENABLE_GTM_WORKERS=false

# Apify Google Maps Scraper — get token at https://console.apify.com/account/integrations
# Required for live GTM sourcing (or use /ingest endpoint for manual data)
# APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxx

# Anthropic Claude API — get key at https://console.anthropic.com
# Used for AI scoring + outreach generation. Without it, the system
# falls back to deterministic heuristic scoring (still works fine).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
# Optional: override the default scoring model
# SCORING_MODEL=claude-haiku-4-5

# Hunter.io email finder — get key at https://hunter.io/api-keys
# Without it, falls back to common-pattern email guessing (info@, contact@, etc.)
# HUNTER_API_KEY=

# ─── Email (optional - leave blank to use console mock) ──────────────────────
OPENAI_API_KEY=""
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@leadflow.app
